              },
              {
                "textRuns": [
                  {
                    "value": "Sell-out monitorado — soma da receita da amostra de SKUs monitorados; não representa o faturamento total da rede.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
