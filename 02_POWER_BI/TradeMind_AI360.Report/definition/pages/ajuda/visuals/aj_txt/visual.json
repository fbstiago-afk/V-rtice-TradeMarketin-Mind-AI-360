                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "AI Lab — RAG, classificador de ocorrências, guardrails e MLOps exibem telemetria real de execuções locais. Fine-tuning de LLM está pendente (sem infraestrutura).",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#1B3044"
                    }
