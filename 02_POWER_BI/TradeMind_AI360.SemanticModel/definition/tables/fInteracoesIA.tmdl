				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"interacao_id", type text}, {"timestamp", type text}, {"usuario", type text}, {"pergunta", type text}, {"status", type text}, {"resposta", type text}, {"latencia_ms", Int64.Type}}, "en-US")
