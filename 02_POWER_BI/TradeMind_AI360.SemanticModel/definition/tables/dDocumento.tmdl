	partition dDocumento = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dDocumento.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"documento_id", Int64.Type}, {"titulo", type text}, {"tipo", type text}, {"industria_id", Int64.Type}, {"versao", type text}, {"origem", type text}, {"n_trechos", Int64.Type}}, "en-US")
				in
				    Tipos

