	partition fOcorrenciasPDV = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fOcorrenciasPDV.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"ocorrencia_id", Int64.Type}, {"data", type date}, {"pdv_id", Int64.Type}, {"descricao", type text}, {"categoria_prevista", type text}, {"prioridade", type text}, {"confianca", type number}, {"sintetico", Int64.Type}}, "en-US")
