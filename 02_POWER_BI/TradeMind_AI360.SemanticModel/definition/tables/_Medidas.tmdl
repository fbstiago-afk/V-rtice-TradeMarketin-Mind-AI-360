table _Medidas
	lineageTag: c2456cac-c5c3-8ea1-a107-1eee3edb33a5

	measure Sell-out = SUM(fVenda[receita])
		formatString: "R$" #,0
		displayFolder: 01 Vendas
		lineageTag: 9e0a8098-6292-9fbd-dfac-c5c7c581b498

	measure Unidades = SUM(fVenda[unidades])
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 0b1927a6-162d-01fc-e18b-9d7588654919

	measure 'Preço Médio' = DIVIDE([Sell-out], [Unidades])
		formatString: "R$" #,0.00
		displayFolder: 01 Vendas
		lineageTag: 69c789a6-d46e-a7f7-bd12-32b4b41b3a4c

	measure 'Sell-out AA' = CALCULATE([Sell-out], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: "R$" #,0
		displayFolder: 01 Vendas
		lineageTag: b729e650-6e2e-9d3d-9b66-a3c00645a10e

	measure 'Sell-out Var %' = VAR c = CALCULATE([Sell-out], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) VAR a = CALCULATE([Sell-out AA], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) RETURN IF(NOT ISBLANK(a) && NOT ISBLANK(c), DIVIDE(c - a, a))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: 337e0672-6431-b723-8568-c0315379a268

	measure 'Unidades AA' = CALCULATE([Unidades], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 1c2822ae-bceb-ae85-7da2-5c4ea44b58ae

	measure 'Unidades Var %' = VAR c = CALCULATE([Unidades], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) VAR a = CALCULATE([Unidades AA], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) RETURN IF(NOT ISBLANK(a) && NOT ISBLANK(c), DIVIDE(c - a, a))
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: 01 Vendas
		lineageTag: 2448fce5-c974-b268-5909-d7d2eb31def8

	measure 'PDVs Monitorados' = DISTINCTCOUNT(fVenda[pdv_id])
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 0de3175e-67bc-e8d1-141b-049f9e52a13f

	measure 'PDVs Cadastrados' = COUNTROWS(dPDV)
		formatString: #,0
		displayFolder: 01 Vendas
		lineageTag: 05f026ae-b436-96ad-ab06-79064246318b

	measure 'Meta Receita (amostra)' = SUM(fMeta[meta_receita])
		formatString: "R$" #,0
		displayFolder: 01 Vendas
		lineageTag: 15cc1740-4683-8db3-0982-91e427e9b763

	measure 'Atingimento Meta (amostra) %' = DIVIDE([Sell-out], [Meta Receita (amostra)])
		formatString: 0.0%
		displayFolder: 01 Vendas
		lineageTag: d1b12e75-99a9-c12a-c48e-964d39cc7227

	measure 'Ruptura %' = AVERAGE(fEstoque[ruptura])
		formatString: 0.0%
		displayFolder: 02 Ruptura
		lineageTag: 21048d5e-1d7b-d0fb-9ecc-129937bb068f

	measure 'Observações Estoque' = COUNTROWS(fEstoque)
		formatString: #,0
		displayFolder: 02 Ruptura
		lineageTag: 57469a65-8b7d-b385-a78a-d0b739c115ed

	measure 'Observações com Ruptura' = SUM(fEstoque[ruptura])
		formatString: #,0
		displayFolder: 02 Ruptura
		lineageTag: dbd05ca0-c8d8-dd63-7ca7-b0c8568676db

	measure 'Ruptura AA' = CALCULATE([Ruptura %], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: 0.0%
		displayFolder: 02 Ruptura
		lineageTag: 5b90fa93-0789-323b-9b69-29289a377364

	measure 'Ruptura Var pp' = VAR c = CALCULATE([Ruptura %], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) VAR a = CALCULATE([Ruptura AA], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) RETURN IF(NOT ISBLANK(a) && NOT ISBLANK(c), c - a)
		formatString: +0.00%;-0.00%
		displayFolder: 02 Ruptura
		lineageTag: d1881d86-9764-0d74-3675-1a4d0f043dc2

	measure 'SKUs com Ruptura' = CALCULATE(DISTINCTCOUNT(fEstoque[produto_id]), fEstoque[ruptura] = 1)
		formatString: #,0
		displayFolder: 02 Ruptura
		lineageTag: 433ced7b-9c9a-7569-e5e9-76a72f374409

	measure 'Conformidade Checklist %' = DIVIDE(AVERAGE(fVisita[checklist_pct]), 100)
		formatString: 0.0%
