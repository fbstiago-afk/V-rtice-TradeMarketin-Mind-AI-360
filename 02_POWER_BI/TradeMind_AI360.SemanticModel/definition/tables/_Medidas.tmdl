	measure 'Conformidade AA' = CALCULATE([Conformidade Checklist %], SAMEPERIODLASTYEAR(dCalendario[Data]))
		formatString: 0.0%
		displayFolder: 03 Execução
		lineageTag: fd82d1fd-d636-7af0-7f8a-02c79d9647e0

	measure 'Conformidade Var pp' = VAR c = CALCULATE([Conformidade Checklist %], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) VAR a = CALCULATE([Conformidade AA], KEEPFILTERS(FILTER(ALL(dCalendario[Data]), dCalendario[Data] >= EDATE(CALCULATE(MIN(fVenda[data]), REMOVEFILTERS()), 12)))) RETURN IF(NOT ISBLANK(a) && NOT ISBLANK(c), c - a)
		formatString: +0.00%;-0.00%
		displayFolder: 03 Execução
		lineageTag: 8161782e-0c97-d69b-84d4-1ccd3c5266c4

	measure Visitas = COUNTROWS(fVisita)
		formatString: #,0
