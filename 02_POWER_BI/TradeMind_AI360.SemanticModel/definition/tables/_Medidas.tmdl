		lineageTag: 394b1cab-e7b9-ad5a-67cc-5f6462447862

	measure 'Planograma OK %' = AVERAGE(fAuditoria[planograma_ok])
		formatString: 0.0%
		displayFolder: 03 Execução
		lineageTag: 3755159d-8c88-2234-ab9b-cd3bb62fc242

	measure 'Material PDV OK %' = AVERAGE(fAuditoria[material_pdv_ok])
		formatString: 0.0%
		displayFolder: 03 Execução
		lineageTag: d542efa0-b200-1e28-9a58-6ca05c2b830e

	measure 'Índice Preço vs Concorrente' = DIVIDE(SUM(fAuditoria[preco_gondola]), SUM(fAuditoria[preco_concorrente]))
		formatString: 0.00
		displayFolder: 03 Execução
		lineageTag: a22bb0c3-4a2d-0df8-6945-082654fc48d8

	measure Auditorias = COUNTROWS(fAuditoria)
		formatString: #,0
		displayFolder: 03 Execução
		lineageTag: 97a40876-7888-ca99-8c72-ef9c814b359e

	measure 'Execução Campanha %' = DIVIDE(AVERAGE(fExecCampanha[execucao_pct]), 100)
		formatString: 0.0%
		displayFolder: 04 Campanhas
		lineageTag: 38482d65-6b1b-0480-1a93-6345a0972c42

	measure 'Custo Campanhas' = SUM(fExecCampanha[custo])
		formatString: "R$" #,0
		displayFolder: 04 Campanhas
		lineageTag: 6ab1e7a3-f5a0-19d0-2c41-f9906ca12e8c

	measure 'Orçamento Campanhas' = SUM(dCampanha[orcamento])
		formatString: "R$" #,0
		displayFolder: 04 Campanhas
		lineageTag: b10de7de-edf1-93b9-49e9-f11ca1fd382d

	measure 'Custo por p.p. Execução' = DIVIDE([Custo Campanhas], [Execução Campanha %] * 100)
		formatString: "R$" #,0
		displayFolder: 04 Campanhas
		lineageTag: fc9b0d5b-119b-d59b-3cc2-5cba0ad7a444

	measure 'PDVs com Campanha' = DISTINCTCOUNT(fExecCampanha[pdv_id])
		formatString: #,0
		displayFolder: 04 Campanhas
		lineageTag: ef85072f-64e7-745f-de38-b1e20d4f3057

	measure 'Índice Atenção' = IF(NOT ISBLANK([Ruptura %]), [Ruptura %] * (1 - COALESCE([Conformidade Checklist %], 0.8)))
		formatString: 0.0000
		displayFolder: 05 Priorização
		lineageTag: bcbaa2d8-9b8f-6125-7e0f-16e1a8f6ca38

	measure 'Score Atenção' = IF(NOT ISBLANK([Índice Atenção]), [Índice Atenção] * 1000)
		formatString: 0.0
		displayFolder: 05 Priorização
		lineageTag: 8acd642b-44e1-f8d4-e93c-784013abb813

	measure 'Ruptura Média Geral' = CALCULATE([Ruptura %], ALLSELECTED(dPDV))
		formatString: 0.0%
		displayFolder: 05 Priorização
		lineageTag: 01835e83-88b5-7450-b85d-755af9f0b8e4

	measure Prioridade =
			VAR r = RANKX(ALLSELECTED(dPDV[pdv]), [Índice Atenção], , DESC)
			RETURN IF(ISBLANK([Índice Atenção]), BLANK(), IF(r <= 10, "P1 · Alta", IF(r <= 40, "P2 · Média", "P3 · Monitorar")))
		displayFolder: 05 Priorização
		lineageTag: 53d10612-e140-fc96-c9c2-c3ab7cacca41

	measure 'Ação Investigativa (hipótese)' =
			VAR ru = [Ruptura %] VAR ck = [Conformidade Checklist %] VAR mg = [Ruptura Média Geral]
			RETURN IF(ISBLANK(ru), BLANK(),
			    IF(ru > mg * 1.15, "Checar reposição e pedido",
			    IF(ck < 0.8, "Revisar checklist com promotor",
			    IF([Planograma OK %] < 0.6, "Auditar planograma", "Monitorar"))))
		displayFolder: 05 Priorização
		lineageTag: 68822fc6-70b9-88b1-905a-f267b7db3348

	measure 'SVG KPI Sell-out' =
			VAR _v = [Sell-out]
			VAR _txt = FORMAT(DIVIDE(_v, 1000000), "R$ #,0.00") & " mi"
			VAR _d = [Sell-out Var %]
			VAR _dtxt = IF(ISBLANK(_d), "sem base comparável", IF(_d >= 0, "▲ ", "▼ ") & FORMAT(ABS(_d), "0.0%") & " vs ano ant.")
			VAR _dcol = IF(ISBLANK(_d), "#64748B", IF(_d >= 0, "#16856A", "#C85B60"))
			VAR _t = FILTER(TOPN(12, ADDCOLUMNS(VALUES(dCalendario[AnoMes]), "@v", [Sell-out]), dCalendario[AnoMes], DESC), NOT ISBLANK([@v]))
			VAR _n = COUNTROWS(_t) VAR _mn = MINX(_t, [@v]) VAR _mx = MAXX(_t, [@v])
			VAR _pts = CONCATENATEX(_t,
			    VAR i = RANKX(_t, dCalendario[AnoMes], , ASC)
			    RETURN FORMAT(300 + (i - 1) * 150 / MAX(_n - 1, 1), "0") & "," & FORMAT(118 - DIVIDE([@v] - _mn, _mx - _mn, 0.5) * 46, "0"), " ", dCalendario[AnoMes], ASC)
			VAR _spark = IF(_n >= 2, "<polyline points='" & _pts & "' fill='none' stroke='#06436E' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/><text x='450' y='146' text-anchor='end' font-size='12' fill='#64748B'>últimos " & _n & " meses</text>", "")
			VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160' viewBox='0 0 470 160' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='1' y='1' width='468' height='158' rx='16' fill='#FFFFFF' stroke='#E6EDF3'/>"
			    & "<g transform='translate(20,20)'><rect width='40' height='40' rx='12' fill='#06436E' fill-opacity='0.12'/><path d='M8 26 L16 18 L22 22 L32 12' fill='none' stroke='#06436E' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/><path d='M26 12 H32 V18' fill='none' stroke='#06436E' stroke-width='3' stroke-linecap='round'/></g>"
			    & "<text x='72' y='38' font-size='16' font-weight='600' fill='#1B3044'>Sell-out monitorado</text>"
			    & "<text x='72' y='56' font-size='13' fill='#64748B'>" & "amostra de SKUs monitorados" & "</text>"
			    & "<text x='22' y='112' font-size='38' font-weight='700' fill='#082746'>" & _txt & "</text>"
			    & "<text x='22' y='142' font-size='14' font-weight='600' fill='" & _dcol & "'>" & _dtxt & "</text>"
			    & _spark & "</svg>"
			VAR _empty = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160'><rect x='1' y='1' width='468' height='158' rx='16' fill='#F1F5F9' stroke='#E6EDF3'/><text x='235' y='86' text-anchor='middle' font-family='Segoe UI' font-size='16' fill='#64748B'>Sell-out monitorado: sem dados no contexto</text></svg>"
			RETURN IF(ISBLANK(_v), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_empty, "%", "%25"), "#", "%23"), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23"))
		displayFolder: 90 SVG
		lineageTag: 341356c3-9460-0f03-a525-497b1080c1d9
		dataCategory: ImageUrl

	measure 'SVG KPI Unidades' =
			VAR _v = [Unidades]
			VAR _txt = FORMAT(DIVIDE(_v, 1000), "#,0.0") & " mil"
			VAR _d = [Unidades Var %]
			VAR _dtxt = IF(ISBLANK(_d), "sem base comparável", IF(_d >= 0, "▲ ", "▼ ") & FORMAT(ABS(_d), "0.0%") & " vs ano ant.")
			VAR _dcol = IF(ISBLANK(_d), "#64748B", IF(_d >= 0, "#16856A", "#C85B60"))
			VAR _t = FILTER(TOPN(12, ADDCOLUMNS(VALUES(dCalendario[AnoMes]), "@v", [Unidades]), dCalendario[AnoMes], DESC), NOT ISBLANK([@v]))
			VAR _n = COUNTROWS(_t) VAR _mn = MINX(_t, [@v]) VAR _mx = MAXX(_t, [@v])
			VAR _pts = CONCATENATEX(_t,
			    VAR i = RANKX(_t, dCalendario[AnoMes], , ASC)
			    RETURN FORMAT(300 + (i - 1) * 150 / MAX(_n - 1, 1), "0") & "," & FORMAT(118 - DIVIDE([@v] - _mn, _mx - _mn, 0.5) * 46, "0"), " ", dCalendario[AnoMes], ASC)
			VAR _spark = IF(_n >= 2, "<polyline points='" & _pts & "' fill='none' stroke='#4387AD' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/><text x='450' y='146' text-anchor='end' font-size='12' fill='#64748B'>últimos " & _n & " meses</text>", "")
			VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160' viewBox='0 0 470 160' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='1' y='1' width='468' height='158' rx='16' fill='#FFFFFF' stroke='#E6EDF3'/>"
			    & "<g transform='translate(20,20)'><rect width='40' height='40' rx='12' fill='#4387AD' fill-opacity='0.12'/><rect x='9' y='9' width='10' height='10' rx='2' fill='none' stroke='#4387AD' stroke-width='3'/><rect x='21' y='21' width='10' height='10' rx='2' fill='none' stroke='#4387AD' stroke-width='3'/></g>"
			    & "<text x='72' y='38' font-size='16' font-weight='600' fill='#1B3044'>Unidades na amostra</text>"
			    & "<text x='72' y='56' font-size='13' fill='#64748B'>" & "unidades vendidas (amostra)" & "</text>"
			    & "<text x='22' y='112' font-size='38' font-weight='700' fill='#082746'>" & _txt & "</text>"
			    & "<text x='22' y='142' font-size='14' font-weight='600' fill='" & _dcol & "'>" & _dtxt & "</text>"
			    & _spark & "</svg>"
			VAR _empty = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160'><rect x='1' y='1' width='468' height='158' rx='16' fill='#F1F5F9' stroke='#E6EDF3'/><text x='235' y='86' text-anchor='middle' font-family='Segoe UI' font-size='16' fill='#64748B'>Unidades na amostra: sem dados no contexto</text></svg>"
			RETURN IF(ISBLANK(_v), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_empty, "%", "%25"), "#", "%23"), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23"))
		displayFolder: 90 SVG
		lineageTag: d6bd037a-8426-5c77-60ac-b04eae7a8e60
		dataCategory: ImageUrl

	measure 'SVG KPI Ruptura' =
			VAR _v = [Ruptura %]
			VAR _txt = FORMAT(_v, "0.0%")
			VAR _d = [Ruptura Var pp]
			VAR _dtxt = IF(ISBLANK(_d), "sem base comparável", IF(_d >= 0, "▲ ", "▼ ") & FORMAT(ABS(_d) * 100, "0.00") & " p.p." & " vs ano ant.")
			VAR _dcol = IF(ISBLANK(_d), "#64748B", IF(_d <= 0, "#16856A", "#C85B60"))
			VAR _t = FILTER(TOPN(12, ADDCOLUMNS(VALUES(dCalendario[AnoMes]), "@v", [Ruptura %]), dCalendario[AnoMes], DESC), NOT ISBLANK([@v]))
			VAR _n = COUNTROWS(_t) VAR _mn = MINX(_t, [@v]) VAR _mx = MAXX(_t, [@v])
			VAR _pts = CONCATENATEX(_t,
			    VAR i = RANKX(_t, dCalendario[AnoMes], , ASC)
			    RETURN FORMAT(300 + (i - 1) * 150 / MAX(_n - 1, 1), "0") & "," & FORMAT(118 - DIVIDE([@v] - _mn, _mx - _mn, 0.5) * 46, "0"), " ", dCalendario[AnoMes], ASC)
			VAR _spark = IF(_n >= 2, "<polyline points='" & _pts & "' fill='none' stroke='#F58200' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/><text x='450' y='146' text-anchor='end' font-size='12' fill='#64748B'>últimos " & _n & " meses</text>", "")
			VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160' viewBox='0 0 470 160' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='1' y='1' width='468' height='158' rx='16' fill='#FFFFFF' stroke='#E6EDF3'/>"
			    & "<g transform='translate(20,20)'><rect width='40' height='40' rx='12' fill='#F58200' fill-opacity='0.12'/><rect x='10' y='12' width='20' height='18' rx='3' fill='none' stroke='#F58200' stroke-width='3'/><path d='M10 18 H30' stroke='#F58200' stroke-width='3'/></g>"
			    & "<text x='72' y='38' font-size='16' font-weight='600' fill='#1B3044'>Ruptura semanal observada</text>"
			    & "<text x='72' y='56' font-size='13' fill='#64748B'>" & FORMAT([Observações Estoque], "#,0") & " obs. PDV×SKU" & "</text>"
			    & "<text x='22' y='112' font-size='38' font-weight='700' fill='#082746'>" & _txt & "</text>"
			    & "<text x='22' y='142' font-size='14' font-weight='600' fill='" & _dcol & "'>" & _dtxt & "</text>"
			    & _spark & "</svg>"
			VAR _empty = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160'><rect x='1' y='1' width='468' height='158' rx='16' fill='#F1F5F9' stroke='#E6EDF3'/><text x='235' y='86' text-anchor='middle' font-family='Segoe UI' font-size='16' fill='#64748B'>Ruptura semanal observada: sem dados no contexto</text></svg>"
			RETURN IF(ISBLANK(_v), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_empty, "%", "%25"), "#", "%23"), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23"))
		displayFolder: 90 SVG
		lineageTag: 09b43049-224f-239e-cae9-c33a4efe1b06
		dataCategory: ImageUrl

	measure 'SVG KPI Conformidade' =
			VAR _v = [Conformidade Checklist %]
			VAR _txt = FORMAT(_v, "0.0%")
			VAR _d = [Conformidade Var pp]
			VAR _dtxt = IF(ISBLANK(_d), "sem base comparável", IF(_d >= 0, "▲ ", "▼ ") & FORMAT(ABS(_d) * 100, "0.00") & " p.p." & " vs ano ant.")
			VAR _dcol = IF(ISBLANK(_d), "#64748B", IF(_d >= 0, "#16856A", "#C85B60"))
			VAR _t = FILTER(TOPN(12, ADDCOLUMNS(VALUES(dCalendario[AnoMes]), "@v", [Conformidade Checklist %]), dCalendario[AnoMes], DESC), NOT ISBLANK([@v]))
			VAR _n = COUNTROWS(_t) VAR _mn = MINX(_t, [@v]) VAR _mx = MAXX(_t, [@v])
			VAR _pts = CONCATENATEX(_t,
			    VAR i = RANKX(_t, dCalendario[AnoMes], , ASC)
			    RETURN FORMAT(300 + (i - 1) * 150 / MAX(_n - 1, 1), "0") & "," & FORMAT(118 - DIVIDE([@v] - _mn, _mx - _mn, 0.5) * 46, "0"), " ", dCalendario[AnoMes], ASC)
			VAR _spark = IF(_n >= 2, "<polyline points='" & _pts & "' fill='none' stroke='#16856A' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/><text x='450' y='146' text-anchor='end' font-size='12' fill='#64748B'>últimos " & _n & " meses</text>", "")
			VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160' viewBox='0 0 470 160' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='1' y='1' width='468' height='158' rx='16' fill='#FFFFFF' stroke='#E6EDF3'/>"
			    & "<g transform='translate(20,20)'><rect width='40' height='40' rx='12' fill='#16856A' fill-opacity='0.12'/><path d='M10 21 L17 28 L30 13' fill='none' stroke='#16856A' stroke-width='3.5' stroke-linecap='round' stroke-linejoin='round'/></g>"
			    & "<text x='72' y='38' font-size='16' font-weight='600' fill='#1B3044'>Conformidade de execução</text>"
			    & "<text x='72' y='56' font-size='13' fill='#64748B'>" & FORMAT([Visitas], "#,0") & " visitas com checklist" & "</text>"
			    & "<text x='22' y='112' font-size='38' font-weight='700' fill='#082746'>" & _txt & "</text>"
			    & "<text x='22' y='142' font-size='14' font-weight='600' fill='" & _dcol & "'>" & _dtxt & "</text>"
			    & _spark & "</svg>"
			VAR _empty = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160'><rect x='1' y='1' width='468' height='158' rx='16' fill='#F1F5F9' stroke='#E6EDF3'/><text x='235' y='86' text-anchor='middle' font-family='Segoe UI' font-size='16' fill='#64748B'>Conformidade de execução: sem dados no contexto</text></svg>"
			RETURN IF(ISBLANK(_v), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_empty, "%", "%25"), "#", "%23"), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23"))
