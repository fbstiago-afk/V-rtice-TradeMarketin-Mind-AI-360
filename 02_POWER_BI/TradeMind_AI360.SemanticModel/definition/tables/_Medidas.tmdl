	measure 'SVG KPI PDVs' =
			VAR _v = [PDVs Monitorados]
			VAR _txt = FORMAT(_v, "#,0")
			VAR _d = BLANK()
			VAR _dtxt = IF(ISBLANK(_d), "sem base comparável", IF(_d >= 0, "▲ ", "▼ ") & "" & " vs ano ant.")
			VAR _dcol = IF(ISBLANK(_d), "#64748B", IF(_d >= 0, "#16856A", "#C85B60"))
			VAR _t = FILTER(TOPN(12, ADDCOLUMNS(VALUES(dCalendario[AnoMes]), "@v", [PDVs Monitorados]), dCalendario[AnoMes], DESC), NOT ISBLANK([@v]))
			VAR _n = COUNTROWS(_t) VAR _mn = MINX(_t, [@v]) VAR _mx = MAXX(_t, [@v])
			VAR _pts = CONCATENATEX(_t,
			    VAR i = RANKX(_t, dCalendario[AnoMes], , ASC)
			    RETURN FORMAT(300 + (i - 1) * 150 / MAX(_n - 1, 1), "0") & "," & FORMAT(118 - DIVIDE([@v] - _mn, _mx - _mn, 0.5) * 46, "0"), " ", dCalendario[AnoMes], ASC)
			VAR _spark = IF(_n >= 2, "<polyline points='" & _pts & "' fill='none' stroke='#082746' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/><text x='450' y='146' text-anchor='end' font-size='12' fill='#64748B'>últimos " & _n & " meses</text>", "")
			VAR _svg = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160' viewBox='0 0 470 160' font-family='Segoe UI, sans-serif'>"
			    & "<rect x='1' y='1' width='468' height='158' rx='16' fill='#FFFFFF' stroke='#E6EDF3'/>"
			    & "<g transform='translate(20,20)'><rect width='40' height='40' rx='12' fill='#082746' fill-opacity='0.12'/><path d='M9 17 L12 10 H28 L31 17 Z' fill='none' stroke='#082746' stroke-width='3' stroke-linejoin='round'/><rect x='11' y='17' width='18' height='13' fill='none' stroke='#082746' stroke-width='3'/></g>"
			    & "<text x='72' y='38' font-size='16' font-weight='600' fill='#1B3044'>PDVs monitorados</text>"
			    & "<text x='72' y='56' font-size='13' fill='#64748B'>" & "de " & FORMAT([PDVs Cadastrados], "#,0") & " PDVs cadastrados" & "</text>"
			    & "<text x='22' y='112' font-size='38' font-weight='700' fill='#082746'>" & _txt & "</text>"
			    & "<text x='22' y='142' font-size='14' font-weight='600' fill='" & _dcol & "'>" & _dtxt & "</text>"
			    & _spark & "</svg>"
			VAR _empty = "<svg xmlns='http://www.w3.org/2000/svg' width='470' height='160'><rect x='1' y='1' width='468' height='158' rx='16' fill='#F1F5F9' stroke='#E6EDF3'/><text x='235' y='86' text-anchor='middle' font-family='Segoe UI' font-size='16' fill='#64748B'>PDVs monitorados: sem dados no contexto</text></svg>"
			RETURN IF(ISBLANK(_v), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_empty, "%", "%25"), "#", "%23"), "data:image/svg+xml;utf8," & SUBSTITUTE(SUBSTITUTE(_svg, "%", "%25"), "#", "%23"))
		displayFolder: 90 SVG
		lineageTag: 19b2ce92-5064-43da-09b4-e91124df47ea
		dataCategory: ImageUrl

