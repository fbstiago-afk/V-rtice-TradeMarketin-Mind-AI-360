	partition fExperimentosML = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fExperimentosML.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"experimento", type text}, {"modelo", type text}, {"versao", type text}, {"timestamp", type text}, {"metrica", type text}, {"valor", type number}, {"status", type text}}, "en-US")
				in
				    Tipos

