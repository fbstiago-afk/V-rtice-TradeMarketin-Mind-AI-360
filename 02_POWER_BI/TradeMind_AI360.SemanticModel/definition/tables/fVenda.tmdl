table fVenda
	lineageTag: b97b17e7-a18a-44d9-5756-e0ec1dad5800

	column data
		dataType: dateTime
		isHidden
		formatString: dd/mm/yyyy
		lineageTag: 3511968b-d359-b1bf-7e7b-b2b5a9649c4c
		summarizeBy: none
		sourceColumn: data

		annotation UnderlyingDateTimeDataType = Date

	column pdv_id
		dataType: int64
		isHidden
		lineageTag: 00ef03b4-574e-f030-acd5-d6918b262476
		summarizeBy: none
		sourceColumn: pdv_id

	column produto_id
		dataType: int64
		isHidden
		lineageTag: 3e6482d4-6e1b-24b8-5da5-723ae3cc7ba0
		summarizeBy: none
		sourceColumn: produto_id

	column unidades
		dataType: int64
		isHidden
		lineageTag: 3a601b83-581a-1e43-ba52-f25c3274324f
		summarizeBy: none
		sourceColumn: unidades

	column receita
		dataType: double
		isHidden
		formatString: #,0.00
		lineageTag: 02cca88f-fceb-4a6d-7836-33a7ad437749
		summarizeBy: none
		sourceColumn: receita

	partition fVenda = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "fVenda.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"data", type date}, {"pdv_id", Int64.Type}, {"produto_id", Int64.Type}, {"unidades", Int64.Type}, {"receita", type number}}, "en-US")
				in
				    Tipos

