				    Fonte = Csv.Document(File.Contents(PastaDados & "dModelosIA.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"modelo", type text}, {"versao", type text}, {"modulo", type text}, {"descricao", type text}, {"status", type text}, {"data_treinamento", type text}}, "en-US")
				in
