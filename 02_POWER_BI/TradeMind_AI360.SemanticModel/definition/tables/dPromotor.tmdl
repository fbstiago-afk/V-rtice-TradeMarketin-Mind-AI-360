	partition dPromotor = m
		mode: import
		source =
				let
				    Fonte = Csv.Document(File.Contents(PastaDados & "dPromotor.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Cab = Table.PromoteHeaders(Fonte, [PromoteAllScalars=true]),
				    Tipos = Table.TransformColumnTypes(Cab, {{"promotor_id", Int64.Type}, {"promotor", type text}, {"regiao_promotor", type text}, {"ativo", Int64.Type}}, "en-US")
				in
				    Tipos

